DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
API_PORT=

# openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Origens do web app, separadas por vírgula (ex.: http://localhost:5173)
CORS_ORIGINS=
# false só em desenvolvimento local sem HTTPS
COOKIE_SECURE=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Care Senior <nao-responda@caresenior.app>
# Página do web app que recebe ?token=... para definir a nova senha
PASSWORD_RESET_URL=

# openssl rand -base64 32 — trocar a chave torna ilegíveis os CPFs já gravados
CPF_ENCRYPTION_KEY=

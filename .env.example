DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
API_PORT=

# openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated web app origins (e.g. http://localhost:5173)
CORS_ORIGIN=
# false only for local development without HTTPS
COOKIE_SECURE=true
# Reverse proxies (load balancer, ingress) in front of the API; 0 when exposed
# directly. The login throttling counts attempts per client IP behind them.
TRUST_PROXY=0

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Care Senior <nao-responda@caresenior.app>
# Web app page that receives ?token=... to set the new password
PASSWORD_RESET_URL=
# Web app page that receives ?token=... for a new staff member to create a password
STAFF_INVITE_URL=
# Page that receives ?token=... for a guardian registered by the clinic staff to create a password
GUARDIAN_INVITE_URL=

# openssl rand -base64 32 — changing it makes stored CPFs unreadable
CPF_ENCRYPTION_KEY=

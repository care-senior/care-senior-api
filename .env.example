# Docker Compose service name: from inside the API container, localhost is the container itself
DB_HOST=db
# Port published on the host; the API container always reaches Postgres on 5432
DB_PORT=5432
DB_USERNAME=care_senior
# openssl rand -base64 24
DB_PASSWORD=
DB_NAME=care_senior
API_PORT=3000

# openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated web app origins (care-senior-web dev server)
CORS_ORIGIN=http://localhost:5173
# false only for local development without HTTPS
COOKIE_SECURE=true
# Reverse proxies (load balancer, ingress) in front of the API; 0 when exposed
# directly. The login throttling counts attempts per client IP behind them.
TRUST_PROXY=0

# Mailpit (docker compose): sent e-mails show up at http://localhost:${MAILPIT_UI_PORT}
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Care Senior <nao-responda@caresenior.app>
MAILPIT_UI_PORT=8025
# Web app page that receives ?token=... to set the new password
PASSWORD_RESET_URL=http://localhost:5173/redefinir-senha
# Web app page that receives ?token=... for a new staff member to create a password
STAFF_INVITE_URL=http://localhost:5173/criar-senha
# Page that receives ?token=... for a guardian registered by the clinic staff to create a password
GUARDIAN_INVITE_URL=http://localhost:5173/responsavel/criar-senha

# openssl rand -base64 32 — changing it makes stored CPFs unreadable
CPF_ENCRYPTION_KEY=
